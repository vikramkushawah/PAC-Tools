<Window x:Class="PacTools.UI.ElementCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element Count - PAC Tools"
        Width="580" Height="660"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="White"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- The accent colours must match PacTools.Core.Brand.AccentHex / AccentDarkHex. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0F5E8C" />
        <SolidColorBrush x:Key="AccentDark" Color="#0A4463" />
        <SolidColorBrush x:Key="Muted" Color="#5B6670" />
        <SolidColorBrush x:Key="Line" Color="#DDE2E6" />
        <SolidColorBrush x:Key="ProblemText" Color="#A3231C" />
        <SolidColorBrush x:Key="ProblemBack" Color="#FDECEA" />
        <SolidColorBrush x:Key="ProblemLine" Color="#F2B8B4" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="86" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Heading -->
        <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Element Count" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Header}" Foreground="#CFE3EF" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- 2. What to count -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,14,16,0">
            <TextBlock Text="Count:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <RadioButton Content="Active view" Margin="10,0,0,0" VerticalAlignment="Center"
                         GroupName="Scope" IsChecked="{Binding IsActiveViewScope, Mode=TwoWay}" />
            <RadioButton Content="Whole model" Margin="14,0,0,0" VerticalAlignment="Center"
                         GroupName="Scope" IsChecked="{Binding IsWholeModelScope, Mode=TwoWay}" />
            <TextBlock Text="waiting for Revit..." Margin="16,0,0,0" VerticalAlignment="Center"
                       FontStyle="Italic" Foreground="{StaticResource Muted}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 3. Anything that went wrong -->
        <Border Grid.Row="2" Margin="16,12,16,0" Padding="12,9"
                Background="{StaticResource ProblemBack}"
                BorderBrush="{StaticResource ProblemLine}" BorderThickness="1" CornerRadius="3"
                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource ProblemText}" TextWrapping="Wrap" />
        </Border>

        <!-- 4. The table -->
        <ListView Grid.Row="3" Margin="16,12,16,0"
                  ItemsSource="{Binding Rows}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1"
                  IsSynchronizedWithCurrentItem="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Category" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Elements" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CountText}" TextAlignment="Right" MinWidth="64" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Share" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShareText}" TextAlignment="Right" MinWidth="54"
                                           Foreground="{StaticResource Muted}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 5. Summary -->
        <StackPanel Grid.Row="4" Margin="16,10,16,0">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ReadAtText}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 6. Buttons -->
        <Border Grid.Row="5" Margin="0,12,0,0" Padding="16,12"
                Background="#F6F8F9" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="The model is only read, never changed."
                           VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Style="{StaticResource Action}" Command="{Binding RefreshCommand}" />
                    <Button Content="Copy CSV" Style="{StaticResource Action}" Command="{Binding CopyCsvCommand}" />
                    <Button Content="Save CSV..." Style="{StaticResource Action}" Click="SaveCsv_Click" />
                    <Button Content="Close" Style="{StaticResource Action}" IsCancel="True" Click="CloseWindow_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
